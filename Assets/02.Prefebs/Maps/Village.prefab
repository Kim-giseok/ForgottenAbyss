--- !u!114 &2050319053884790119
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6748838853228515342}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fc8cc23607f355545b64ad8dfc0dd081, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - "\uB610 \uD55C \uBA85\uC774 \uB208\uC744 \uB5B4\uAD70. \uB108\uB3C4... \uADF8\uB4E4
    \uC911 \uD558\uB098\uC778\uAC00 \uBCF4\uAD70"
  - "\uC5EC\uAE34 '\uACBD\uACC4\uC758 \uD2C8', \uC774\uC2B9\uB3C4 \uC800\uC2B9\uB3C4
    \uC544\uB2CC \uACF3. \uC78A\uD600\uC9C4 \uB098\uB77D\uC758 \uBB38\uD131\uC774\uC9C0"
  - "\uAE30\uC5B5\uC774 \uC5C6\uACA0\uC9C0. \uAD1C\uCC2E\uC544. \uC774\uACF3\uC5D0
    \uC624\uB294 \uC790\uB4E4\uC740 \uBAA8\uB450 \uADF8\uB7AC\uC73C\uB2C8\uAE4C"
  - "\uB3CC\uC544\uAC00\uACE0 \uC2F6\uB2E4\uBA74,  \uC6B0\uB450\uBA38\uB9AC\uB4E4\u2026
    \uADF8\uB4E4\uC758 \uD798\uC744 \uD761\uC218\uD574. \uADF8\uB9AC\uACE0 \uAE30\uC5B5\uC744
    \uB418\uCC3E\uC544"
  - "\uB124 \uC548\uC5D0\uB294 \u2018\uADF8\uB9BC\uC790\u2019\uC758 \uD754\uC801\uC774
    \uC788\uC5B4.\uB108\uB294 \uADF8\uAC83\uC744 \uB2E4\uB8F0 \uC218 \uC788\uC744\uAC70\uC57C"
  - "\uAE30\uC5B5\uC744 \uB418\uCC3E\uB294 \uAC74 \uACE7 \uB108\uC758 \uC815\uCCB4\uB97C
    \uB9C8\uC8FC\uD558\uB294 \uC77C\uC774\uC57C. \uC900\uBE44\uB294 \uB418\uC5C8\uB098?"
  displayEndEvents:
    m_PersistentCalls:
      m_Calls: []
